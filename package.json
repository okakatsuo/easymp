{
  "name": "easymp",
  "version": "0.2.0",
  "description": "Unofficial TypeScript library for controlling and displaying images on classic Epson EasyMP projectors",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okakatsuo/easymp.git"
  },
  "homepage": "https://github.com/okakatsuo/easymp#readme",
  "bugs": {
    "url": "https://github.com/okakatsuo/easymp/issues"
  },
  "license": "MIT",
  "author": "okakatsuo",
  "keywords": [
    "epson",
    "easymp",
    "projector",
    "escvp",
    "escvp21",
    "bun",
    "typescript"
  ],
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && bun build ./src/index.ts --outdir ./dist --target node --format esm --external sharp && bunx tsc -p tsconfig.build.json",
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "test:package": "bunx tsc -p test/package/tsconfig.json && node test/package/import.mjs",
    "verify": "bun run check && bun test && bun run build && bun run test:package",
    "prepack": "bun run verify",
    "dev": "bun run examples/red-square.ts",
    "example:audio": "bun run examples/audio.ts",
    "example:image": "bun run examples/image.ts",
    "example:movie": "bun run examples/movie.ts",
    "example:power": "bun run examples/power.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
