{
  "name": "easymp",
  "version": "0.1.0",
  "description": "Control and display images on classic Epson EasyMP projectors from Bun or Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external sharp",
    "check": "bunx tsc --noEmit",
    "test": "bun test",
    "dev": "bun run examples/red-square.ts",
    "example:image": "bun run examples/image.ts",
    "example:power": "bun run examples/power.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
